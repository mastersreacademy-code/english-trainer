{
  "name": "family-learning-staging",
  "compatibility_date": "2026-10-30",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {"name": "FAMILY_AUTH", "class_name": "FamilyAuth"}
    ]
  },
  "migrations": [
    {"tag": "staging-family-auth-v1", "new_sqlite_classes": ["FamilyAuth"]}
  ],
  "vars": {
    "EMAIL_TEST_MODE": "true",
    "EMAIL_TEST_RECIPIENT": "moonlittran@gmail.com"
  }
}
